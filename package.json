{
  "name": "ecscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deep visibility into your AWS ECS workloads",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o0Zz/ECScope.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/o0Zz/ECScope/issues"
  },
  "homepage": "https://github.com/o0Zz/ECScope#readme",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1026.0",
    "@aws-sdk/client-auto-scaling": "^3.1026.0",
    "@aws-sdk/client-cloudwatch": "^3.1017.0",
    "@aws-sdk/client-ec2": "^3.1018.0",
    "@aws-sdk/client-ecs": "^3.1017.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1017.0",
    "@aws-sdk/client-rds": "^3.1018.0",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/client-secrets-manager": "^3.1018.0",
    "@aws-sdk/client-ssm": "^3.1017.0",
    "@aws-sdk/client-sts": "^3.1017.0",
    "@tanstack/react-query": "^5.95.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tslog": "^4.10.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.2"
  }
}
