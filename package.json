{
  "name": "ecscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deep visibility into your AWS ECS workloads",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o0Zz/ECScope.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/o0Zz/ECScope/issues"
  },
  "homepage": "https://github.com/o0Zz/ECScope#readme",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1143.0",
    "@aws-sdk/client-auto-scaling": "^3.1143.0",
    "@aws-sdk/client-cloudwatch": "^3.1143.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1143.0",
    "@aws-sdk/client-ec2": "^3.1143.0",
    "@aws-sdk/client-ecs": "^3.1143.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1143.0",
    "@aws-sdk/client-eventbridge": "^3.1143.0",
    "@aws-sdk/client-rds": "^3.1143.0",
    "@aws-sdk/client-scheduler": "^3.1143.0",
    "@aws-sdk/client-secrets-manager": "^3.1143.0",
    "@aws-sdk/client-ssm": "^3.1143.0",
    "@aws-sdk/client-sts": "^3.1143.0",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
